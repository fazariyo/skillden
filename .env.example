# Where "Book a call" enquiries are forwarded (server-only). Any endpoint that accepts JSON POSTs:
# a Zapier/Make webhook, a HubSpot integration, SheetDB, etc. Without it, the form offers a pre-filled email instead.
LEAD_WEBHOOK_URL=

# Careers applications (recruitment inbox/tracker, never the sales CRM).
NEXT_PUBLIC_APPLICATION_ENDPOINT=
